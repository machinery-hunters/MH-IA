# ─────────────────────────────────────────────────────────────────────────
# Copia este archivo a .env (PowerShell: Copy-Item .env.example .env) y rellena.
# .env NUNCA se versiona. Los secretos reales solo viven en .env y en
# credentials/ (ambos ignorados por git).
# ─────────────────────────────────────────────────────────────────────────

# ── Entorno ─────────────────────────────────────────────────────────────
# "production" activa la validación estricta de secretos al arrancar la API
# (falla explícitamente si falta alguno). DEBUG apagado por defecto.
MHIA_ENV=development
MHIA_DEBUG=false

# ── Claude (razonamiento final; solo recibe contexto anonimizado) ───────
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Ollama local (clasificación, anonimización, embeddings) ─────────────
# NO fijar OLLAMA_BASE_URL aquí: cada override de docker-compose lo define
# (gpu -> http://ollama:11434, mac -> http://host.docker.internal:11434).
# Solo descomentar si corres el pipeline fuera de Docker.
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Qdrant (no publica puerto al host; solo lo alcanza mhia-api) ────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=mhia_drive_docs
# Piso de relevancia (0-1). Con nomic-embed-text un umbral absoluto NO separa lo relevante
# de lo irrelevante (medido en el laboratorio: lab\calibrar_umbral.py); solo descarta lo
# claramente ajeno. El filtro que sí ayuda es el margen relativo de abajo.
RETRIEVAL_SCORE_THRESHOLD=0.6
# Solo se conservan los fragmentos con score a menos de este margen del mejor (minimiza
# lo que viaja a Claude). 0 = desactivado.
RETRIEVAL_SCORE_MARGIN=0.06

# ── Anonimizador local ──────────────────────────────────────────────────
# Tope de tiempo (segundos) por llamada al LLM local que detecta nombres propios.
# Si se excede, no se envía nada a Claude (falla cerrada).
ANONYMIZER_TIMEOUT_S=45
ANONYMIZER_NUM_CTX=4096
# Términos que NO se redactan aunque el LLM los marque como nombre (la propia empresa y
# marcas públicas de maquinaria). Separados por comas; opcional.
# ANONYMIZER_KEEP_TERMS=Machinery Hunters,MH,Caterpillar,Komatsu

# ── Google Drive (ingesta + conector) ───────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=/app/credentials/service_account.json
GOOGLE_DRIVE_FOLDER_ID=
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
SYNC_MANIFEST_PATH=/app/data/sync_manifest.json

# ── ERP Frappe/ERPNext (pendiente del proveedor; no bloqueante) ─────────
# Usuario de SOLO LECTURA. Si quedan vacías, el ERP se marca "no configurado".
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# ── CRM GoHighLevel ─────────────────────────────────────────────────────
# Token de integración privada con el alcance mínimo (solo lectura).
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_TOKEN=
GHL_LOCATION_ID=

# ── Firestore / Supabase (SourcingBot, portafolio aprobado) ─────────────
# Credenciales de solo lectura. El JSON de Firestore va en credentials/.
FIRESTORE_PROJECT_ID=
FIRESTORE_CREDENTIALS_FILE=/app/credentials/firestore_service_account.json
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Timeouts por sub-agente (segundos) ──────────────────────────────────
# Una fuente lenta se marca "timeout" y NO bloquea a las demás.
TIMEOUT_DRIVE_S=15
TIMEOUT_ERP_S=10
TIMEOUT_CRM_S=10
TIMEOUT_FIRESTORE_S=10
TIMEOUT_GLOBAL_S=30

# ── API / acceso remoto ─────────────────────────────────────────────────
# Secreto de sesión: mínimo 32 caracteres, obligatorio en producción.
# Generar en PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
API_SESSION_SECRET=
# Clave Fernet que cifra en reposo los secretos TOTP. Obligatoria en producción.
# Generar: python -m pipeline_ai.security.manage gen-key
API_TOTP_KEY=
# Base de datos de usuarios y sesiones (SQLite, permisos 0600). Vive en ./data (volumen).
# Los usuarios se crean SOLO con la CLI: python -m pipeline_ai.security.manage create-user
AUTH_DB_PATH=/app/data/auth.db
# Inactividad y duración máxima de la sesión (segundos).
SESSION_IDLE_S=1800
SESSION_ABSOLUTE_S=43200
# Fallos de login antes de bloquear la cuenta, y segundos de bloqueo base.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_S=900
# Cookie Secure (+ prefijo __Host-): por defecto solo en production. Para probar por
# http://localhost fuera de producción déjala en false.
# API_COOKIE_SECURE=true
# Hosts aceptados en la cabecera Host. En producción agrega el nombre MagicDNS
# del tailnet, p.ej. mhia-brain.tu-tailnet.ts.net
API_ALLOWED_HOSTS=localhost,127.0.0.1,mhia-api
# Consultas (POST /api/v1/query): duración máxima en segundos (la GUI espera hasta 130 s;
# mantén este valor por debajo) y consultas simultáneas (Ollama corre en un solo equipo).
QUERY_TIMEOUT_S=120
QUERY_MAX_CONCURRENCY=2

# ── Tailscale (acceso remoto privado) ───────────────────────────────────
# Tailscale se instala en el HOST (no en Docker) y NO usa ninguna clave en
# este archivo. Ver DEPLOYMENT.md, sección "Acceso remoto". Esta variable es
# solo documental: el nombre del equipo en el tailnet.
TAILNET_HOSTNAME=
