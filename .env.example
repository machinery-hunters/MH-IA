# Claude (razonamiento complejo / redacción final)
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama local (privacidad / embeddings / clasificación)
# NO fijar OLLAMA_BASE_URL aquí: cada override de docker-compose lo define
# según el entorno (docker-compose.gpu.yml -> http://ollama:11434,
# docker-compose.mac.yml -> http://host.docker.internal:11434).
# Déjalo vacío o coméntalo salvo que corras app/main.py fuera de Docker.
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=mhia_drive_docs

# ERPNext (Fase 2)
ERPNEXT_BASE_URL=https://erp.machineryhunters.local
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Umbral mínimo de relevancia para aceptar un chunk recuperado (0-1)
RETRIEVAL_SCORE_THRESHOLD=0.72

# Ingesta Google Drive (Fase 1)
GOOGLE_SERVICE_ACCOUNT_FILE=/app/credentials/service_account.json
GOOGLE_DRIVE_FOLDER_ID=
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
SYNC_MANIFEST_PATH=/app/data/sync_manifest.json
