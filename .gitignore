# Secretos (nunca se versionan)
.env
.env.*
!.env.example
credentials/*.json
credentials/*.pem
credentials/*.key
*.pem
*.key

# Datos locales generados
data/*.json
data/*.log

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Web (Next.js)
web/node_modules/
web/.next/
web/out/
web/.env*.local
web/next-env.d.ts
web/*.tsbuildinfo

# SO / editor
.DS_Store
Thumbs.db

# Resultados del laboratorio (datos sinteticos, pero no tienen por que versionarse)
services/pipeline_ai/lab/results/
# Preguntas reales para evaluar la recuperacion (mencionan datos del negocio): nunca a git.
services/pipeline_ai/lab/real_golden.json

# Preferencias locales de Claude Code (plugins activos por usuario)
.claude/settings.local.json
**/data/*.db
**/data/*.db-wal
**/data/*.db-shm
**/data/*.db-journal

# Respaldos locales (contienen datos del negocio)
backups/*
!backups/.gitkeep

# Importaciones con datos personales (por ejemplo, la lista de usuarios): nunca a git
**/data/*.csv
**/data/*.xlsx
